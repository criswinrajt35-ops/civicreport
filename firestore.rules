rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() ? profile().role : null; }
    function superAdmin() { return role() == 'SUPER_ADMIN' && profile().authorityStatus == 'VERIFIED'; }
    function departmentStaff() { return role() == 'DEPARTMENT_MEMBER' || role() == 'DEPARTMENT_HEAD'; }
    function citizen() { return role() == 'CITIZEN'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'CITIZEN' &&
        !request.resource.data.keys().hasAny(['authorityStatus', 'authorityApplication', 'authorityVerifiedAt', 'authorityVerifiedBy']);
      allow update: if superAdmin() ||
        (signedIn() &&
          request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.departmentId == resource.data.departmentId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'notificationPreferences']));
      allow delete: if superAdmin();
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if superAdmin();
    }

    match /authorityAudit/{auditId} {
      allow read: if superAdmin();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    match /complaints/{complaintId} {
      allow read: if signedIn() && (
        superAdmin() ||
        (citizen() && resource.data.citizenUid == request.auth.uid) ||
        (departmentStaff() &&
          profile().authorityStatus == 'VERIFIED' &&
          profile().departmentId != null &&
          resource.data.departmentIds != null &&
          resource.data.departmentIds.hasAny([profile().departmentId]))
      );
      allow create: if false;
      allow update: if superAdmin() ||
        (citizen() &&
          resource.data.citizenUid != request.auth.uid &&
          !('isMerged' in resource.data) &&
          !('mergedIntoComplaintId' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporterUids', 'supportCount', 'updatedAt']) &&
          request.resource.data.supporterUids.size() == resource.data.supporterUids.size() + 1 &&
          request.resource.data.supporterUids.hasAny([request.auth.uid]) &&
          request.resource.data.supportCount == request.resource.data.supporterUids.size()) ||
        (departmentStaff() &&
         resource.data.assignments != null &&
         resource.data.departmentIds != null &&
         resource.data.departmentIds.hasAny([profile().departmentId]) &&
         request.resource.data.assignments == resource.data.assignments &&
         request.resource.data.citizenUid == resource.data.citizenUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'evidence', 'resolution', 'updatedAt']) &&
         (request.resource.data.status != 'Resolved' ||
          request.resource.data.evidence.after.size() > resource.data.evidence.after.size()));
      allow delete: if superAdmin();

      match /activity/{activityId} {
        allow read: if signedIn() && (
          superAdmin() ||
          (citizen() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.citizenUid == request.auth.uid) ||
          (departmentStaff() &&
            get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignments != null &&
            get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignments.hasAny([profile().departmentId]))
        );
        allow write: if false;
      }

      match /feedbackHistory/{feedbackId} {
        allow read: if signedIn() && (
          superAdmin() ||
          get(/databases/$(database)/documents/complaints/$(complaintId)).data.citizenUid == request.auth.uid ||
          (departmentStaff() &&
            get(/databases/$(database)/documents/complaints/$(complaintId)).data.departmentIds.hasAny([profile().departmentId]))
        );
        allow create, update, delete: if false;
      }

      match /reopeningHistory/{reopeningId} {
        allow read: if signedIn() && (
          superAdmin() ||
          get(/databases/$(database)/documents/complaints/$(complaintId)).data.citizenUid == request.auth.uid ||
          (departmentStaff() &&
            get(/databases/$(database)/documents/complaints/$(complaintId)).data.departmentIds.hasAny([profile().departmentId]))
        );
        allow create, update, delete: if false;
      }
    }
  }
}
